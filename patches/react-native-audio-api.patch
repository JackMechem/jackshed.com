+      // noiseSuppression: false, autoGainControl: false})`, which tunes a bass guitar cleanly.
+      // The resulting low recorded volume is exactly what this app's own adaptive-gain step
+      // (`lib/audioInput.ts`) already exists to compensate for.
+      ->setInputPreset(oboe::InputPreset::Unprocessed)
       ->setDataCallback(shared_from_this())
       ->setErrorCallback(shared_from_this());
 
