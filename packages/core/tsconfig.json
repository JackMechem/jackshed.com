{
  "compilerOptions": {
    "target": "ES2021",
    // "DOM" is for the ambient `crypto.randomUUID()` global's type declaration only (the Web
    // Crypto API, available as a global in browsers, Node 19+, and Convex's own runtime alike) —
    // this package has no actual DOM dependency; both its consumers (apps/web, packages/convex)
    // are non-browser-DOM environments for the Convex side, so nothing here should ever touch a
    // real `document`/`window`.
    "lib": ["ES2021", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
